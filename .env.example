# Copy to .env and fill in. .env is gitignored: never commit your key.
#   cp .env.example .env

# On a machine with an NVIDIA GPU, uncomment the COMPOSE_FILE line. Docker
# Compose then adds the GPU overlay to every command. Leave it commented on a
# machine without one: everything still runs, on the CPU.
# Linux and macOS:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Windows (the path separator is a semicolon there):
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# Weights & Biases. Get your key from https://wandb.ai/authorize and paste it
# here. Left empty, runs are logged to an anonymous account with a link you can
# claim later; fine for the first lab, not for the semester.
WANDB_API_KEY=

# online   log to wandb.ai (normal)
# offline  log to disk only, sync later with `wandb sync`
# disabled turn logging off entirely
WANDB_MODE=online
